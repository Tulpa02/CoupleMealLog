# 统一换行符，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto

# 代码文件统一用 LF
*.dart text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf

# 二进制文件不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.jks binary
*.keystore binary
